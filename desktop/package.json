{
  "name": "murrkit-desktop",
  "productName": "murrkit",
  "version": "0.3.0",
  "description": "Desktop shell (Electron) for murrkit — lives in the repo under desktop/; installer + node_modules + release output stay git-ignored.",
  "private": true,
  "main": "main.js",
  "author": "druidcat",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.druidcat.murrkit",
    "productName": "murrkit",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
