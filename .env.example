# murrkit — environment variables
# Copy this file to `.env` and fill in the keys you need. `.env` is gitignored.
#
# NOTE: murrkit needs one local coding agent as its orchestrator captain.
# Claude Code is the upstream default. Set MURRKIT_AGENT_CLI=codex to use
# Codex CLI instead.

# ── Local coding agent / captain ────────────────────────────────────────────
MURRKIT_AGENT_CLI=claude
CLAUDE_CLI_BIN=claude
# Optional: Anthropic API key for the Claude Code captain. Leave blank to use
# your Claude subscription login. Set it to bill via the Anthropic API instead —
# required when the pinned captain model (claude-fable-5) is not included in
# your subscription plan. Key: https://platform.claude.com
ANTHROPIC_API_KEY=
CODEX_CLI_BIN=codex
# Optional Codex settings. Leave model fields blank to let Codex use its
# configured default model.
CODEX_MODEL=
CODEX_MODEL_FAST=
CODEX_MODEL_HEAVY=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never

# ── LLM: code reasoning + log/console triage ───────────────────────────────
# DeepSeek (OpenAI-compatible API). Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # default — uncomment to override
# DEEPSEEK_MODEL=deepseek-v4-flash             # default

# ── Vision: screenshot QA / compare-gate ───────────────────────────────────
# Google Gemini. Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash                # default

# ── Image generation: sprite sheets ────────────────────────────────────────
# murrkit routes image generation through the Kitty image API (a hosted proxy —
# one token for every image workflow). Get a token: https://druidcat.app/dashboard
KITTY_APP_TOKEN=

# ── Audio (optional): SFX / music / voice ──────────────────────────────────
# ElevenLabs. Key: https://elevenlabs.io
ELEVENLABS_API_KEY=

# ── Backend ────────────────────────────────────────────────────────────────
BACKEND_PORT=8001
# Auto-generated on first run if left blank (printed to the startup log).
BACKEND_AUTH_TOKEN=
# Optional public URL of this backend (cloudflared / ngrok / your domain) for
# image-edit workflows that take reference images by URL only. Local-only: leave blank.
PUBLIC_BACKEND_URL=

# ── Budget guard ────────────────────────────────────────────────────────────
# Hard stop on cumulative provider spend (USD).
BUDGET_LIMIT_USD=80

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
